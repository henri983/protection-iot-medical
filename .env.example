# Configuration de la passerelle IoMT et API
GATEWAY_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET_KEY_FOR_EDGE_GATEWAY_HMAC
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY_MIN_32_CHARS
AES_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Paramètres Réseau & Sécurité IoMT
ALLOWED_DEVICE_TYPES=pulse_oximeter,ecg_monitor,insulin_pump,temperature_sensor
MAX_TELEMETRY_RATE_PER_MINUTE=60
MTLS_STRICT_MODE=true
ENVIRONMENT=development
LOG_LEVEL=INFO
